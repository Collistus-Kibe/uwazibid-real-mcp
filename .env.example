# Gemini API Keys (Automatic rotation & failover across multiple keys)
# Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# Primary: gemini-2.5-flash
# Open-Weights Track: gemma-4-31b-it / gemma-4-26b-a4b-it
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash
GEMMA_OPEN_WEIGHTS_MODEL=gemma-4-31b-it

# OpenAI API Keys (Secondary provider with automatic key rotation)
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_MODEL=gpt-4o-mini

# Preferred Provider Ordering: "gemini" -> "gemma" -> "openai" -> "groq" -> "ollama"
LLM_PROVIDER=gemini

# Optional Groq or Local Ollama Fallback
GROQ_API_KEY=
OPEN_WEIGHTS_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen2.5:7b
